# --- Secrets (never commit) ---
kaggle.json
.kaggle/
*.env
.env*
credentials*.json
service_account*.json
.claude/settings.local.json

# --- Python / environments ---
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

