data/raw/
data/raw_v2/ee_cache/
data/raw_v2/ee_test/
data/raw_v2/scan_hourly/
data/raw_v2/*.out
*.partial.parquet

# --- Test / scratch runs ---
data/processed_v2_test/
data/processed_v2_test2/
results_v2_test/

# --- Per-fold checkpoints (final tables are kept) ---
results_v2/tables/v3_polaris_ck/
results_v2/tables/v4_trees_ck/

